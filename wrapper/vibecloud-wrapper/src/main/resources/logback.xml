<configuration>
    <!--
      Gleiches Format wie im Master: <Datum Zeit> <LEVEL> - <Meldung>.
      Der Wrapper hat keine eigene Konsole, deshalb bleibt es beim ConsoleAppender.
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{dd.MM.yyyy HH:mm:ss} %highlight(%-5level) - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
