<configuration>
    <!--
      Format: <Datum Zeit> <LEVEL> - <Meldung>. Der Logger-Name fehlt absichtlich -
      "d.k.v.m.g.NodeServiceImpl" sagt dem Betreiber nichts, die Meldung sagt alles.
      Fuer die Fehlersuche steht er im DEBUG-Profil wieder zur Verfuegung.

      TerminalAppender statt ConsoleAppender: Der schreibt durch den LineReader und
      laesst die Eingabezeile stehen (siehe TerminalAppender).
    -->
    <appender name="CONSOLE" class="de.kevloe.vibecloud.master.console.TerminalAppender">
        <encoder>
            <pattern>%d{dd.MM.yyyy HH:mm:ss} %highlight(%-5level) - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
